pipeline {
    agent any

    stages {
        stage('Checkout') {
            steps {
                git branch: 'feature/devops-pipeline', url: 'https://github.com/pavanimadhavarapu/restaurant-management-system.git'
            }
        }

        stage('Install & Test') {
            steps {
                sh '''
                    echo "📦 Installing dependencies"
                    npm install

                    echo "🧪 Running tests"
                    npm test || echo "⚠️ No tests found, skipping..."
                '''
            }
        }
    }

    post {
        success {
            echo "✅ Code build/test success! Now run Docker build & deploy manually in MobaXterm 🚀"
        }
        failure {
            echo "❌ Build failed! Check errors above."
        }
    }
}


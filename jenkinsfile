pipeline {
    agent any

    environment {
        DOCKER_IMAGE = "pavanimadhavarapu/restaurant-management-system"
    }

    stages {
        stage('Checkout') {
            steps {
                git branch: 'feature/devops-pipeline', url: 'https://github.com/pavanimadhavarapu/restaurant-management-system.git'
            }
        }

        stage('Install & Test') {
            agent {
                docker {
                    image 'node:18'      // Node.js container
                    args '-u root:root' // run as root
                }
            }
            steps {
                sh '''
                    echo "📦 Installing dependencies"
                    npm install

                    echo "🧪 Running tests"
                    npm test || echo "⚠️ No tests found, skipping..."
                '''
            }
        }

        stage('Docker Build & Push') {
            steps {
                script {
                    docker.withRegistry('https://index.docker.io/v1/', 'dockerhub-credentials') {
                        def app = docker.build("${DOCKER_IMAGE}:${BUILD_NUMBER}")
                        app.push()
                        app.push("latest")
                    }
                }
            }
        }

        stage('Run Container (Optional)') {
            steps {
                sh '''
                    echo "🚀 Running container locally for verification"
                    docker stop restaurant-container || true
                    docker rm restaurant-container || true
                    docker run -d --name restaurant-container -p 8080:80 ${DOCKER_IMAGE}:${BUILD_NUMBER}
                '''
            }
        }
    }

    post {
        success {
            echo "✅ Build Success: Image pushed to Docker Hub 🚀"
        }
        failure {
            echo "❌ Build Failed! Check Jenkins logs."
        }
    }
}

